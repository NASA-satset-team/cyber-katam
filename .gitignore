# ---------------------------------------------------------------------------
# CYBER-KATAM .gitignore
# Keep the repository free of virtual environments, credentials,
# large raw satellite files, and temporary build/test outputs.
# ---------------------------------------------------------------------------

# Python virtual environments
.venv/
**/.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Secrets and credentials (never commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
service_account*.json
**/earthengine-private-key.json
**/.config/earthengine/
**/.ee/
.netrc
secrets/

# Raw and processed satellite data (large, reproducible from source)
# Keep the README/.gitkeep files that document each folder.
data/raw/*
data/processed/*
!data/raw/README.md
!data/processed/README.md
!data/raw/.gitkeep
!data/processed/.gitkeep

# Common large geospatial/raster outputs anywhere in the repo
*.tif
*.tiff
*.hdf
*.hdf5
*.h5
*.nc
*.nc4
*.jp2
*.vrt
*.grd
*.img
*.sqlite
*.gpkg
*.mbtiles
*.pmtiles
*.las
*.laz
*.parquet.tmp
*.geojson.tmp

# Temporary outputs
*.tmp
*.temp
*.log
tmp/
temp/
scratch/

# JavaScript / frontend
node_modules/
.next/
out/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
